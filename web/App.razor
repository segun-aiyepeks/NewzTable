@using web.Layout

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudContainer Class="state-container">
                <div class="state-icon-circle" style="background-color: var(--mud-palette-error-containeer)">
                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Style="color:var(--mud-palette-error)" Size="Size.Large" />
                </div>
                <MudText Typo="Typo.h6" Align="Align.Center">
                    Page not Found...
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    The page you are looking for does not exist.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" StartIcon="@Icons.Material.Outlined.Home">
                    Go Home
                </MudButton>
            </MudContainer>
        </LayoutView>
    </NotFound>
</Router>
