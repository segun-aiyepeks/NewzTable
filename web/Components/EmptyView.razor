@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Inbox;
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}

<div class="state-container">
    <div class="state-icon-circle" style="background-color: var(--mud-palette-primary-container)">
        <MudIcon Icon="@Icon" Style="color:var(--mud-palette-primary)" Size="Size.Large" />
    </div>

    <MudText Typo="Typo.h6" Align="Align.Center" Style="font-weight:700"> @Title</MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Style="max-width:300px"> @Message</MudText>

    @if(!string.IsNullOrEmpty(ActionLabel) && OnAction.HasDelegate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OnAction"> @ActionLabel</MudButton> 
    }
</div>