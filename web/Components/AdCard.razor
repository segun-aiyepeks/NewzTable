<MudCard Elevation="0" Class="ad-card mb-2">
    <div style="padding:6px 12px">
        <span class="ad-label" style="background-color:var(--mud-palette-secondary-container); color:var(--mud-palette-secondary-container-text); padding:2px 6px; border-radius:4px">
            Sponsored
        </span>
    </div>

    <div class="ad-placeholder">
        <MudIcon Icon="@Icons.Material.Outlined.Campaign" Color="Color.Secondary" Size="Size.Large" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">Advertisement</MudText>
        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-disabled); font-size:10px"> @SlotId</MudText>
    </div>
</MudCard>

@code {
    [Parameter] public string SlotId { get; set; } = string.Empty;
}
